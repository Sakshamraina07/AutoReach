# AutoReach dashboard (Vite). Copy to .env.local for local development.
# Every VITE_ variable is compiled into the public JavaScript bundle:
# never put secrets here. The Supabase anon key is designed to be public;
# row-level security on the database is what protects data.

# Base URL of the AutoReach API (backend/), without a trailing slash.
VITE_API_URL=http://localhost:3001

# Supabase project used for Google sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show the local development sign-in form (works only against a local API
# started with ENABLE_DEV_LOGIN=true and a local database). Leave false in
# any deployed build.
VITE_DEV_LOGIN=false

# Optional: where users can get the Chrome extension (shown in the UI).
VITE_EXTENSION_URL=

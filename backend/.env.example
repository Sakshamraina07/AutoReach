# =====================================================================
# AutoReach API — environment variables
# Copy to backend/.env for local development. Never commit real values.
# Full explanations: docs/SETUP.md, docs/GMAIL_OAUTH.md, docs/AI_PROVIDERS.md
# =====================================================================

# --- Runtime ----------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=3001
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY_HOPS=1              # proxies in front of the API (Railway/Render = 1)

# Public URL of this API. Used for the Gmail OAuth redirect URI and for
# open-tracking pixel URLs (tracking needs https).
API_PUBLIC_URL=http://localhost:3001
# The web dashboard origin (CORS + where Gmail OAuth returns to).
DASHBOARD_URL=http://localhost:5173
# Extra allowed browser origins, comma-separated (for example a second dashboard domain or a
# Vercel preview URL). Not needed for the Chrome extension: its service worker has host access
# to the API, so its requests aren't subject to CORS.
CORS_EXTRA_ORIGINS=

# --- Database (Supabase Postgres) ---------------------------------------
# Supabase: Project Settings → Database → Connection string → "Session pooler" (port 5432).
# The SAME database user must run migrations and the API (it is granted the autoreach_app role).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autoreach
# disable | no-verify | verify   (default: disable for localhost, no-verify otherwise)
DATABASE_SSL=
# Path to Supabase's CA certificate when DATABASE_SSL=verify (Settings → Database → SSL).
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10
# Role used for per-request Row Level Security. Leave as is.
DB_RLS_ROLE=autoreach_app

# --- Supabase Auth & Storage -------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-only secret: private résumé storage + account deletion. NEVER put this in the dashboard or extension.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Supabase "Legacy JWT secret" (Settings → API → JWT). Enables fast local token verification.
SUPABASE_JWT_SECRET=

# supabase | local  (default: supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, else local)
STORAGE_DRIVER=
STORAGE_BUCKET=resumes
STORAGE_LOCAL_DIR=.data/storage   # development only

# --- Gmail (Google OAuth, "Web application" client) ---------------------
# Authorized redirect URI to register in Google Cloud: ${API_PUBLIC_URL}/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 or hex. Encrypts Gmail tokens at rest (AES-256-GCM).
# Generate: npm run gen:key -w @autoreach/backend
# Keep it stable: changing it makes stored Gmail connections unreadable (users must reconnect).
TOKEN_ENCRYPTION_KEY=
# Reply detection asks Google for gmail.metadata (message headers only), a
# Google "restricted" scope. Set false to request only gmail.send: no reply
# detection (mark replies by hand), simpler Google verification. See docs/GMAIL_OAUTH.md.
GMAIL_REPLY_DETECTION=true

# Optional: Chrome extension IDs (comma-separated) allowed to connect Gmail from the
# extension. Empty = any extension ID. Set it to your extension's ID in production.
EXTENSION_IDS=

# --- AI drafting (optional; without it the composer uses your templates) ---
# none | anthropic | openai | groq | gemini | openai_compatible
# Gemini example: AI_PROVIDER=gemini, AI_MODEL=gemini-3.8-flash, AI_API_KEY from aistudio.google.com.
# On Gemini's free tier Google may use what is sent to improve its products (see docs/AI_PROVIDERS.md).
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# Only for openai_compatible (e.g. http://localhost:11434/v1 for Ollama) or to override a provider's default endpoint.
AI_BASE_URL=
AI_TIMEOUT_MS=45000

# --- Optional: career-ops on the same computer (docs/CAREER_OPS.md) -----
# Its scored jobs appear under "From career-ops". Forward slashes work on Windows.
# CAREER_OPS_DIR=D:/career-ops
# Only this signed-in account may read the folder (required with NODE_ENV=production).
# CAREER_OPS_OWNER_EMAIL=

# --- Optional contact discovery ----------------------------------------
# Hunter.io email finder. Results are always labelled unverified.
HUNTER_API_KEY=

# --- Background jobs ----------------------------------------------------
# Set false to run jobs in a separate process: npm run worker -w @autoreach/backend
WORKERS_ENABLED=true

# --- Local development only (refused when NODE_ENV=production) ----------
# Lets you sign in without Supabase against a LOCAL Postgres (creates users in a local auth.users shim).
ENABLE_DEV_LOGIN=false
DEV_JWT_SECRET=

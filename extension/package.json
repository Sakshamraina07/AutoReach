{
  "name": "@autoreach/extension",
  "private": true,
  "version": "2.0.0",
  "description": "AutoReach Chrome extension (Manifest V3)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:watch": "vite build --watch --mode development",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@autoreach/shared": "2.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

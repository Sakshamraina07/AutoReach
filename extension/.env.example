# AutoReach Chrome extension — build-time settings (copied into the bundle).
# Never put secrets here: everything below is visible to anyone who installs
# the extension. AI keys, Google client secrets and the Supabase service-role
# key belong on the server (backend/.env) only.

# AutoReach API (backend/). Its origin becomes the extension's only API host permission.
VITE_API_URL=http://localhost:3001

# Web dashboard, for "Open dashboard" links.
VITE_DASHBOARD_URL=http://localhost:5173

# Supabase project used for sign-in (the anon key is public by design).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local development only: show an email sign-in that calls the API's
# /api/dev/login (works only against a local API with ENABLE_DEV_LOGIN=true).
VITE_DEV_LOGIN=false
